{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MarkforgeConfig",
  "description": "Type-safe configuration schema for @masumdev/markforge Markdown & MDX document publishing engine",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "description": "JSON Schema reference URI for IDE autocompletion and validation"
    },
    "to": {
      "description": "Target formats to compile markdown to (docx, pdf, html, png)",
      "oneOf": [
        {
          "type": "string",
          "enum": ["docx", "pdf", "html", "png"]
        },
        {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["docx", "pdf", "html", "png"]
          }
        }
      ],
      "default": ["docx", "pdf"]
    },
    "outputDir": {
      "type": "string",
      "description": "Output directory where compiled documents will be saved"
    },
    "theme": {
      "description": "Visual document theme (preset 'corporate' or custom ThemeProps object)",
      "oneOf": [
        {
          "type": "string",
          "enum": ["corporate", "default"]
        },
        {
          "type": "object",
          "properties": {
            "primaryColor": { "type": "string" },
            "primaryDark": { "type": "string" },
            "primaryLight": { "type": "string" },
            "backgroundColor": { "type": "string" },
            "textColor": { "type": "string" },
            "textMuted": { "type": "string" },
            "borderColor": { "type": "string" },
            "cardBackground": { "type": "string" },
            "codeBackground": { "type": "string" },
            "codeText": { "type": "string" },
            "fontFamily": { "type": "string" },
            "fontMono": { "type": "string" },
            "customCss": { "type": "string" }
          },
          "additionalProperties": false
        }
      ],
      "default": "corporate"
    },
    "orientation": {
      "type": "string",
      "description": "Page orientation for PDF and DOCX",
      "enum": ["portrait", "landscape"],
      "default": "portrait"
    },
    "paperSize": {
      "type": "string",
      "description": "Standard physical paper size",
      "enum": ["A4", "Letter", "Legal", "A3", "A5"],
      "default": "A4"
    },
    "margins": {
      "type": "object",
      "description": "Document page margins (supports units like '2.5cm', '1in', '20mm', or pt numbers)",
      "properties": {
        "top": { "type": ["string", "number"] },
        "bottom": { "type": ["string", "number"] },
        "left": { "type": ["string", "number"] },
        "right": { "type": ["string", "number"] }
      },
      "additionalProperties": false
    },
    "header": {
      "type": "object",
      "description": "Running header template across document pages (supports {title}, {subtitle}, {author}, {version}, {date}, {company})",
      "properties": {
        "left": {
          "oneOf": [
            { "type": "string" },
            {
              "type": "object",
              "properties": {
                "text": { "type": "string" },
                "color": { "type": "string" },
                "fontSize": { "type": "number" },
                "fontFamily": { "type": "string" },
                "bold": { "type": "boolean" },
                "italic": { "type": "boolean" }
              },
              "required": ["text"],
              "additionalProperties": false
            }
          ]
        },
        "center": {
          "oneOf": [
            { "type": "string" },
            {
              "type": "object",
              "properties": {
                "text": { "type": "string" },
                "color": { "type": "string" },
                "fontSize": { "type": "number" },
                "fontFamily": { "type": "string" },
                "bold": { "type": "boolean" },
                "italic": { "type": "boolean" }
              },
              "required": ["text"],
              "additionalProperties": false
            }
          ]
        },
        "right": {
          "oneOf": [
            { "type": "string" },
            {
              "type": "object",
              "properties": {
                "text": { "type": "string" },
                "color": { "type": "string" },
                "fontSize": { "type": "number" },
                "fontFamily": { "type": "string" },
                "bold": { "type": "boolean" },
                "italic": { "type": "boolean" }
              },
              "required": ["text"],
              "additionalProperties": false
            }
          ]
        },
        "divider": { "type": "boolean" },
        "dividerColor": { "type": "string" },
        "font": { "type": "string" },
        "size": { "type": "number" },
        "color": { "type": "string" }
      },
      "additionalProperties": false
    },
    "footer": {
      "type": "object",
      "description": "Running footer template across document pages (supports {page}, {pages}, {title}, {author}, {date})",
      "properties": {
        "left": {
          "oneOf": [
            { "type": "string" },
            {
              "type": "object",
              "properties": {
                "text": { "type": "string" },
                "color": { "type": "string" },
                "fontSize": { "type": "number" },
                "fontFamily": { "type": "string" },
                "bold": { "type": "boolean" },
                "italic": { "type": "boolean" }
              },
              "required": ["text"],
              "additionalProperties": false
            }
          ]
        },
        "center": {
          "oneOf": [
            { "type": "string" },
            {
              "type": "object",
              "properties": {
                "text": { "type": "string" },
                "color": { "type": "string" },
                "fontSize": { "type": "number" },
                "fontFamily": { "type": "string" },
                "bold": { "type": "boolean" },
                "italic": { "type": "boolean" }
              },
              "required": ["text"],
              "additionalProperties": false
            }
          ]
        },
        "right": {
          "oneOf": [
            { "type": "string" },
            {
              "type": "object",
              "properties": {
                "text": { "type": "string" },
                "color": { "type": "string" },
                "fontSize": { "type": "number" },
                "fontFamily": { "type": "string" },
                "bold": { "type": "boolean" },
                "italic": { "type": "boolean" }
              },
              "required": ["text"],
              "additionalProperties": false
            }
          ]
        },
        "divider": { "type": "boolean" },
        "dividerColor": { "type": "string" },
        "font": { "type": "string" },
        "size": { "type": "number" },
        "color": { "type": "string" }
      },
      "additionalProperties": false
    },
    "toc": {
      "type": "boolean",
      "description": "Auto-generate Table of Contents with page references",
      "default": false
    },
    "watermark": {
      "description": "Watermark configuration across document pages (string or WatermarkOptions object)",
      "oneOf": [
        { "type": "string" },
        { "type": "boolean" },
        {
          "type": "object",
          "properties": {
            "text": { "type": "string" },
            "color": { "type": "string" },
            "opacity": { "type": "number" },
            "fontSize": { "type": "number" },
            "rotate": { "type": "number" },
            "position": {
              "type": "string",
              "enum": ["diagonal", "center", "top-right", "bottom-right"]
            }
          },
          "required": ["text"],
          "additionalProperties": false
        }
      ]
    },
    "css": {
      "description": "Custom CSS stylesheet path(s) to inject into the document",
      "oneOf": [
        { "type": "string" },
        { "type": "array", "items": { "type": "string" } }
      ]
    },
    "syntaxTheme": {
      "type": "string",
      "description": "Code block syntax highlighting color theme",
      "enum": ["github-dark", "github-light", "dracula", "monokai", "nord"],
      "default": "github-dark"
    },
    "coverPage": {
      "description": "Dedicated standalone front cover page configuration",
      "oneOf": [
        { "type": "boolean" },
        {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "preset": { "type": "string", "enum": ["modern", "corporate-split", "minimal", "card"] },
            "title": { "type": "string" },
            "subtitle": { "type": "string" },
            "author": { "type": "string" },
            "company": { "type": "string" },
            "version": { "type": "string" },
            "date": { "type": "string" },
            "badge": { "type": "string" },
            "badgeColor": { "type": "string" },
            "badgeTextColor": { "type": "string" },
            "logo": { "type": "string" },
            "footerText": { "type": "string" }
          },
          "additionalProperties": false
        }
      ]
    },
    "backCover": {
      "description": "Dedicated standalone back cover / closing page configuration",
      "oneOf": [
        { "type": "boolean" },
        {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "preset": { "type": "string", "enum": ["modern", "corporate", "minimal", "contact-card"] },
            "title": { "type": "string" },
            "subtitle": { "type": "string" },
            "company": { "type": "string" },
            "address": { "type": "string" },
            "email": { "type": "string" },
            "phone": { "type": "string" },
            "website": { "type": "string" },
            "social": {
              "type": "object",
              "properties": {
                "github": { "type": "string" },
                "twitter": { "type": "string" },
                "linkedin": { "type": "string" }
              },
              "additionalProperties": true
            },
            "copyright": { "type": "string" }
          },
          "additionalProperties": false
        }
      ]
    },
    "numberHeadings": {
      "description": "Hierarchical decimal section numbering (e.g. 1., 1.1, 1.1.1)",
      "oneOf": [
        { "type": "boolean" },
        {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "depth": { "type": "number", "minimum": 1, "maximum": 6 },
            "skipH1": { "type": "boolean" },
            "prefix": { "type": "string" }
          },
          "additionalProperties": false
        }
      ]
    },
    "math": {
      "type": "boolean",
      "description": "Enable native KaTeX mathematical LaTeX equation rendering ($inline$ and $$block$$)",
      "default": true
    },
    "security": {
      "type": "object",
      "description": "PDF encryption and access permissions",
      "properties": {
        "userPassword": { "type": "string" },
        "ownerPassword": { "type": "string" },
        "permissions": {
          "type": "object",
          "properties": {
            "printing": { "oneOf": [{ "type": "string", "enum": ["highResolution", "lowResolution"] }, { "type": "boolean" }] },
            "modifying": { "type": "boolean" },
            "copying": { "type": "boolean" },
            "annotating": { "type": "boolean" },
            "fillingForms": { "type": "boolean" },
            "contentAccessibility": { "type": "boolean" },
            "documentAssembly": { "type": "boolean" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "signatures": {
      "description": "Signature and approval block layout and signatory definitions",
      "oneOf": [
        {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "title": { "type": "string" },
              "name": { "type": "string" },
              "role": { "type": "string" },
              "date": { "type": "string" },
              "signatureImage": { "type": "string" }
            },
            "required": ["name"]
          }
        },
        {
          "type": "object",
          "properties": {
            "title": { "type": "string" },
            "style": { "type": "string", "enum": ["line", "box", "clean"] },
            "align": { "type": "string", "enum": ["left", "center", "right", "space-between"] },
            "items": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "title": { "type": "string" },
                  "name": { "type": "string" },
                  "role": { "type": "string" },
                  "date": { "type": "string" },
                  "signatureImage": { "type": "string" }
                },
                "required": ["name"]
              }
            }
          },
          "required": ["items"],
          "additionalProperties": false
        }
      ]
    },
    "metadata": {
      "type": "object",
      "description": "Default document metadata dictionary (used as fallback if not in markdown frontmatter)",
      "properties": {
        "title": { "type": "string" },
        "subtitle": { "type": "string" },
        "author": {
          "oneOf": [
            { "type": "string" },
            { "type": "array", "items": { "type": "string" } }
          ]
        },
        "date": { "type": "string" },
        "version": { "type": "string" },
        "company": { "type": "string" },
        "lang": { "type": "string" },
        "coverPage": { "type": "boolean" }
      },
      "additionalProperties": true
    },
    "embedImages": {
      "type": "boolean",
      "description": "Whether to inline/embed all images as Base64 in outputs",
      "default": true
    },
    "bundleHtml": {
      "type": "boolean",
      "description": "Produce self-contained HTML with embedded styles and scripts",
      "default": true
    },
    "watch": {
      "type": "boolean",
      "description": "Watch mode for re-compilation on source file changes",
      "default": false
    },
    "serve": {
      "type": "boolean",
      "description": "Start local preview HTTP server",
      "default": false
    },
    "port": {
      "type": "number",
      "description": "Local preview server port",
      "default": 4000
    },
    "open": {
      "type": "boolean",
      "description": "Automatically open document in browser on compile",
      "default": false
    }
  },
  "additionalProperties": true
}
