{
  "name": "@masumdev/tscheck",
  "version": "0.1.0",
  "description": "A React Native and Expo package for tscheck.",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "react-native",
    "expo",
    "tscheck"
  ],
  "author": "Ma'sum",
  "license": "MIT",
  "homepage": "https://react-native-library-docs.netlify.app/tscheck/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/masumrpg/react-native-library.git",
    "directory": "packages/tscheck"
  },
  "bugs": {
    "url": "https://github.com/masumrpg/react-native-library/issues"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0"
  },
  "peerDependencies": {
    "react": ">=16",
    "react-native": "*",
    "expo": "*"
  },
  "publishConfig": {
    "access": "public"
  }
}
