{
  "name": "@masumdev/tscheck",
  "version": "0.3.0",
  "description": "Modern, high-performance TypeScript AST code audit CLI and engine with beautiful Ink terminal UI and type-safe config.",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "bin": {
    "tscheck": "./dist/cli.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./schema.json": "./schema.json"
  },
  "files": [
    "dist",
    "schema.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "clean": "rm -rf dist",
    "test": "bun test",
    "test:coverage": "bun test --coverage"
  },
  "keywords": [
    "typescript",
    "ast",
    "cli",
    "audit",
    "linter",
    "deprecated",
    "type-safety",
    "ink",
    "tscheck"
  ],
  "author": "Ma'sum",
  "license": "MIT",
  "homepage": "https://react-native-library-docs.vercel.app/tscheck/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/masumrpg/nodejs-lib.git",
    "directory": "packages/tscheck"
  },
  "bugs": {
    "url": "https://github.com/masumrpg/nodejs-lib/issues"
  },
  "dependencies": {
    "commander": "^13.1.0",
    "ink": "^6.1.0",
    "ink-spinner": "^5.0.0",
    "ink-table": "^3.1.0",
    "ink-text-input": "^6.0.0",
    "picocolors": "^1.1.1",
    "react": "^19.0.0",
    "typescript": "^5.7.3"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "ink-testing-library": "^4.0.0",
    "tsup": "^8.3.6"
  },
  "publishConfig": {
    "access": "public"
  }
}
