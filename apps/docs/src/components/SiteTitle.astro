---
import { Image } from 'astro:assets';
import logoImage from '../assets/logo.webp';
---

<a href="/" class="site-title sl-flex">
  <Image
    src={logoImage}
    alt="Masum Dev Logo"
    width={26}
    height={26}
    loading="eager"
    class="rounded-md object-contain"
  />
  <span class="site-title-text">Masum Dev</span>
</a>

<style>
  .site-title {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    font-size: var(--sl-text-base);
    font-weight: 700;
    color: var(--sl-color-white);
    text-decoration: none;
    white-space: nowrap;
  }
  .site-title-text {
    font-weight: 700;
    color: var(--sl-color-white);
  }
</style>
