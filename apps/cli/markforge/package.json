{
  "name": "markforge-playground",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun ../../../packages/markforge/dist/cli.mjs ./docs/document.md",
    "build:open": "bun ../../../packages/markforge/dist/cli.mjs ./docs/document.md -O",
    "watch": "bun ../../../packages/markforge/dist/cli.mjs ./docs/document.md -w",
    "serve": "bun ../../../packages/markforge/dist/cli.mjs ./docs/document.md --serve 3000 --open"
  },
  "dependencies": {
    "@masumdev/markforge": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.7.3"
  }
}
