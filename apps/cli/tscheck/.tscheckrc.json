{
  "$schema": "https://raw.githubusercontent.com/masumrpg/nodejs-lib/main/packages/tscheck/schema.json",
  "rootDir": ".",
  "workspaces": ["."],
  "exclude": ["node_modules", "dist", ".temp"],
  "rules": {
    "deprecated": true,
    "unused": true,
    "noExplicitAny": true
  },
  "reporters": {
    "outputDir": ".temp/json-config-reports",
    "json": true,
    "markdown": true
  },
  "failOnWarning": false
}
